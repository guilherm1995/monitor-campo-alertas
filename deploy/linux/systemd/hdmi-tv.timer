[Unit]
Description=Checagem periodica da TV/HDMI (porta com HPD defeituoso)

[Timer]
# Comeca logo apos o boot (a sessao X sobe rapido, sem VPN no meio do
# caminho) e repete a cada 2 min -- essencial aqui porque a porta HDMI deste
# Dell tem o hotplug detect (HPD) com defeito (ver hdmi-tv.sh): o evento de
# udev sozinho nem sempre dispara, entao o timer e quem garante que a TV
# acaba ligando dentro de ~2 min mesmo se o hotplug falhar.
OnBootSec=10s
OnUnitActiveSec=2min
AccuracySec=10s

[Install]
WantedBy=timers.target
