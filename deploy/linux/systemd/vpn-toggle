#!/bin/sh
# Botao liga/desliga da VPN sempre-ativa. Um clique alterna o estado e mostra
# uma notificacao. Se o systemd pedir senha, o KDE abre o dialogo sozinho.
#
# Chamado pelo lancador ~/.local/share/applications/vpn-toggle.desktop.

UNIT=vpn-sempre-ativa.service
IP_FILE=/home/operador/Documentos/migracao_linux/bot/vpn_ip_atual.txt

notifica() {
    # -e = so enquanto a sessao existe; -h string:... agrupa as notificacoes
    notify-send -a "VPN Provedor" -i "$2" -h "string:x-canonical-private-synchronous:vpn-toggle" "$1" "$3"
}

if systemctl is-active --quiet "$UNIT"; then
    systemctl stop "$UNIT"
    notifica "VPN desligada" network-vpn-disconnected-symbolic \
             "A internet voltou a sair direto."
else
    notifica "Conectando a VPN..." network-vpn-acquiring-symbolic \
             "Tunel-cheio: todo o trafego vai passar pela Provedor."
    systemctl start "$UNIT" || {
        notifica "Falha ao ligar a VPN" network-vpn-no-route-symbolic \
                 "Veja: vpn log"
        exit 1
    }
    # espera o tunel subir e o IP aparecer (ate ~15s)
    i=0
    while [ $i -lt 15 ]; do
        if ip -4 addr show tun0 >/dev/null 2>&1; then
            ip_tun=$(ip -4 -o addr show tun0 | awk '{print $4}' | cut -d/ -f1)
            notifica "VPN ligada" network-vpn-symbolic "IP no tunel: ${ip_tun:-?}"
            exit 0
        fi
        sleep 1
        i=$((i + 1))
    done
    [ -r "$IP_FILE" ] && ip_tun=$(cat "$IP_FILE")
    notifica "VPN ligada" network-vpn-symbolic "IP no tunel: ${ip_tun:-conectando...}"
fi
